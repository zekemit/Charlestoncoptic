# St. Mary & St. George Coptic Orthodox Church website: environment variables.
#
# Local development:  cp .env.example .env.local   then fill in what you need.
# Vercel:             Project > Settings > Environment Variables (see README for the checklist).
#
# Never commit real values. .env.local is git-ignored.

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Password for /admin (the popup manager). Use a long passphrase you don't use anywhere else.
# If this is empty, /admin shows "Admin isn't set up yet" and nobody can sign in.
# Changing it signs out every active admin session.
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# CONTACT FORM  (/contact -> /api/contact)
# Configure ONE of the two providers below, or both (see EMAIL_PROVIDER).
# ---------------------------------------------------------------------------

# Where contact-form messages are delivered. Comma-separate to send to several inboxes.
CONTACT_RECIPIENT=Kaldasms@gmail.com

# Provider A: Resend (https://resend.com)
# Create an API key under API Keys. With the default sender (onboarding@resend.dev), Resend only
# delivers to the email address of the Resend account owner. To send to Kaldasms@gmail.com either
# sign up to Resend with that address, or verify a domain and set RESEND_FROM_EMAIL below.
RESEND_API_KEY=
# Optional. Must be on a domain verified in Resend, e.g.:  St. Mary & St. George <hello@charlestoncoptic.org>
RESEND_FROM_EMAIL=

# Provider B: Gmail SMTP with an App Password (works with any Gmail account)
# Turn on 2-Step Verification for the Gmail account, then create an App Password at
# https://myaccount.google.com/apppasswords . Paste the 16 characters (spaces are ignored).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional. "resend" or "gmail" forces one provider with no fallback.
# Leave empty: Resend is used when its key exists, with Gmail as automatic fallback (and vice versa),
# so a provider outage doesn't lose a visitor's message.
EMAIL_PROVIDER=

# Optional SMTP overrides for the "gmail" provider (defaults: smtp.gmail.com, 465, TLS on 465 only).
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=

# ---------------------------------------------------------------------------
# POPUP STORAGE  (live announcement settings saved from /admin)
# ---------------------------------------------------------------------------
# Production on Vercel: Storage tab > Create > Upstash (Redis) from the Marketplace > connect it to
# this project. Vercel then adds the variables below automatically; you don't type them in.
# The site accepts either naming family.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# or:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
#
# Local development: leave all of the above empty. Settings are saved to data/popup.json instead.
# (Vercel's runtime filesystem is read-only, so without Redis, saving is disabled on Vercel and /admin says so.)

# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------

# Canonical site address used for metadata, sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://www.charlestoncoptic.org

# Separate secret for signing admin sessions. If empty, ADMIN_PASSWORD is used (so changing the
# password also signs everyone out). Generate one with:  openssl rand -base64 32
SESSION_SECRET=
